{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Eleutheria",
  "version": "1.0.0",
  "identifier": "app.eleutheria.client",
  "build": {
    "frontendDist": "./frontend"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Eleutheria",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 620,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self'; script-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Eleutheria: свой VPN на собственном сервере",
    "longDescription": "Установка и управление VPN (sing-box, VLESS+Reality) на собственном сервере и клиент с режимами TUN и локального прокси.",
    "icon": [
      "icons/icon.png",
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0",
          "policykit-1"
        ]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "REPLACE_WITH_UPDATER_PUBLIC_KEY",
      "endpoints": [
        "https://github.com/OWNER/eleutheria/releases/latest/download/latest.json",
        "https://updates.example.org/eleutheria/latest.json"
      ],
      "requireSignedVersion": true,
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
